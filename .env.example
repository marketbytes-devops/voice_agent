# ClinicVoice Environment Configuration Template (.env.example)
# Do NOT commit sensitive keys. Duplicate this file as .env locally.

# Application Environment
APP_ENV=local
DEBUG=true

# Database & Cache
DATABASE_URL=postgresql+asyncpg://clinicvoice:clinicvoice_pass@localhost:5432/clinicvoice_db
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO locally / AWS S3 in production)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=clinicvoice-recordings
OBJECT_STORAGE_KEY=minioadmin
OBJECT_STORAGE_SECRET=minioadmin

# LiveKit Telephony & Agent
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Voice AI Providers (Phase 0 Evaluation)
# Sarvam AI for Malayalam STT and Bulbul TTS
SARVAM_API_KEY=
# LLM Providers (e.g., openai, anthropic, or gemini)
LLM_PROVIDER=openai
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Telephony (Exotel)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# Security & Tokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production
INTERNAL_SERVICE_TOKEN=replace_with_internal_agent_secret
RECORDING_RETENTION_DAYS=30
